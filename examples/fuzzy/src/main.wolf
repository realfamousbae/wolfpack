//! Suggests a command for a mistyped one. The edit distance comes from a package of each target
//! language, declared in `wolfpack.toml` (chapter 7, section 8.6).

module main

extern {
    ts {
        fn distance(a: String, b: String) -> Int from "fastest-levenshtein#distance"
    }
    go {
        fn distance(
            a: String,
            b: String,
        ) -> Int from "github.com/agnivade/levenshtein.ComputeDistance"
    }
    rust {
        fn distance(a: String, b: String) -> Int from "strsim::levenshtein"
    }
}

config {
    /// Words farther than this get no suggestion.
    max_distance: Int = 2
}

main {
    let commands = ["build", "check", "run", "test", "fmt", "explain"]
    for word in ["biuld", "tset", "chek", "rnu", "format"] {
        match suggest(word, commands) {
            Some(command) => print(word + ": did you mean `" + command + "`?")
            None => print(word + ": no suggestion")
        }
    }
}

functions {
    /// The closest command to `word`, if it is close enough; the first one wins a tie.
    fn suggest(word: String, commands: List<String>) -> Option<String> {
        var best: Option<String> = None
        var best_distance = max_distance + 1
        for command in commands {
            let d = distance(word, command)
            if d < best_distance {
                best = Some(command.copy())
                best_distance = d
            }
        }
        best
    }
}

tests {
    test "distance counts single edits" {
        assert(distance("kitten", "sitting") == 3)
        assert(distance("same", "same") == 0)
    }

    test "far words get no suggestion" {
        assert(suggest("format", ["fmt"]) == None)
        assert(suggest("tst", ["test"]) == Some("test"))
    }
}
