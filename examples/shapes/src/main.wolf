//! Shapes: an interface used as a value type (`List<Shape>`), sorting with a closure, and
//! `Comparable` implemented by a user type.

module main

imports {
    std.list
}

types {
    struct Rect {
        w: Float
        h: Float
    }

    struct Square {
        side: Float
    }

    struct Triangle {
        base: Float
        height: Float
    }
}

interfaces {
    interface Shape {
        fn area(self) -> Float
        fn name(self) -> String
    }
}

impl {
    Rect: Shape {
        fn area(self) -> Float { self.w * self.h }
        fn name(self) -> String { "rectangle" }
    }

    Rect: Comparable {
        fn compare(self, other: Self) -> Ordering {
            compare_floats(self.area(), other.area())
        }
    }

    Square: Shape {
        fn area(self) -> Float { self.side * self.side }
        fn name(self) -> String { "square" }
    }

    Triangle: Shape {
        fn area(self) -> Float { self.base * self.height / 2.0 }
        fn name(self) -> String { "triangle" }
    }
}

main {
    var shapes: List<Shape> = [
        Rect { w: 3.0, h: 4.0 },
        Square { side: 2.0 },
        Triangle { base: 6.0, height: 5.0 },
    ]
    list.sort_by(mut shapes, |a, b| compare_floats(a.area(), b.area()))
    for shape in shapes {
        print(shape.name() + ": " + shape.area().to_string())
    }
    print("total: " + total_area(shapes).to_string())

    let rects = [Rect { w: 1.0, h: 1.0 }, Rect { w: 2.0, h: 3.0 }, Rect { w: 0.5, h: 2.0 }]
    match list.max(rects) {
        Some(r) => print("largest rectangle: " + r.w.to_string() + " x " + r.h.to_string())
        None => print("no rectangles")
    }
}

functions {
    /// `Float` is not `Comparable` (NaN), so floats are compared by hand.
    fn compare_floats(a: Float, b: Float) -> Ordering {
        if a < b { Ordering.Less } else if a > b { Ordering.Greater } else { Ordering.Equal }
    }

    fn total_area(shapes: List<Shape>) -> Float {
        var sum = 0.0
        for shape in shapes {
            sum += shape.area()
        }
        sum
    }
}
