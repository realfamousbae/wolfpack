//! A file written carelessly.
module main

imports {
    std.list
    std.string

    std.math
}

types {
    struct Point {
        x: Int
        y: Int
    }
    // Shapes.
    enum Shape {
        Circle(Float)
        Rect { w: Float, h: Float }
        Dot
    }
}

main {
    let p = Point { x: 1, y: 2 }
    // the area
    let a = area(Shape.Rect { w: 2.0, h: 3.0 })
    let numbers = [1, 2, 3]
    let total = list.sum(
        numbers.map(|n| n * 2).filter(|n| n > 2).map(|n| n + long_name_for_a_function(n, n, n)),
    )
    if a > 1.0 { print("big") } else { print("small") }
    print(
        p.x.to_string() + " " + a.to_string() + " " + total.to_string() + " " +
            string.join(["a", "b"], ","),
    )
    print(math.int_max.to_string())
}

functions {
    fn area(s: Shape) -> Float {
        match s {
            Shape.Circle(r) => r * r * 3.0
            Shape.Rect { w, h } => w * h
            Shape.Dot => 0.0
        }
    }

    fn long_name_for_a_function(
        first_argument: Int,
        second_argument: Int,
        third_argument: Int,
    ) -> Int {
        first_argument + second_argument // the sum
    }
}
