module main

imports {
    native.text.slug
}

main {
    print(slug.slugify("Hello World"))
    print(slug.owned("a"))
    print(f"{slug.by_ref_string("abc")} {slug.small(1, 2, 3)} {slug.halve(5.0)}")
    print(f"{slug.sum_vec([1, 2])} {slug.sum_ref_vec([3, 4])} {slug.sum_slice([5, 6])}")
    print(slug.words(["x", "y"])[1])
    let k = slug.keys(["b": 2, "a": 1])
    print(f"{k.keys()[0]} {slug.total(["z": 10])}")
    match slug.parse("41") {
        Ok(n) => print(f"{n + 1}")
        Err(e) => print(e.message())
    }
    match slug.parse("x") {
        Ok(n) => print(f"{n}")
        Err(e) => print(e.message())
    }
    match slug.first(["q"]) {
        Some(s) => print(s)
        None => print("none")
    }
    let c = slug.counter()
    print(f"{slug.count(c)} {slug.each(["aa", "b"], |s| s.len() > 1)}")
    let s = slug.Size { w: 4, h: 2.5, tags: ["a", "b"], note: None }
    print(f"{slug.area(s)}")
    let g = slug.grow(s, 2)
    print(f"{g.w} {g.h} {g.tags.len()}")
    match g.note {
        Some(n) => print(n)
        None => print("no note")
    }
    for f in slug.frames(2) {
        print(f"{f.name} {f.size.w} {f.size.h}")
    }
    match slug.find_frame("f1") {
        Some(f) => print(f"found {f.name}")
        None => print("none")
    }
    match slug.parse_size("3x1.5") {
        Ok(s) => print(f"{s.w} {s.h} {s.tags[0]}")
        Err(e) => print(e.message())
    }
    match slug.parse_size("3") {
        Ok(s) => print(f"{s.w}")
        Err(e) => print(e.message())
    }
    print(f"{slug.total_area([slug.Size { w: 1, h: 2.0, tags: [], note: None }, slug.Size { w: 3, h: 2.0, tags: [], note: None }])}")
    print(slug.widest(["a": slug.Size { w: 3, h: 2.0, tags: [], note: None }, "b": slug.Size { w: 1, h: 2.0, tags: [], note: None }]))
    let st = slug.restock(slug.Stock { counts: ["x": 2] }, "y")
    print(f"{st.counts["x"]} {st.counts["y"]} {st.counts.keys()[1]}")
}
