module main

imports {
    native.text.slug
}

main {
    print(slug.slugify("Hello World"))
    print(f"{slug.small(1, 2, 3)} {slug.halve(5.0)} {slug.parse_url("u")}")
    print(f"{slug.sum_small([1, 2])} {slug.sum_slice([5, 6])}")
    print(slug.words(["x", "y"])[1])
    let k = slug.keys(["b": 2, "a": 1])
    print(f"{k.keys()[0]} {slug.total(["z": 10])}")
    match slug.parse("41") {
        Ok(n) => print(f"{n + 1}")
        Err(e) => print(e.message())
    }
    match slug.parse("x") {
        Ok(n) => print(f"{n}")
        Err(e) => print(e.message())
    }
    match slug.first(["q"]) {
        Some(s) => print(s)
        None => print("none")
    }
    match slug.ratio(0) {
        Some(r) => print(f"{r}")
        None => print("none")
    }
    match slug.check(-1) {
        Ok(_) => print("ok")
        Err(e) => print(e.message())
    }
    let c = slug.new_counter()
    print(f"{slug.count(c)} {slug.each(["aa", "b"], |s| s.len() > 1)}")
    let s = slug.Size { w: 4, h: 2.5, tags: ["a", "b"], note: "", id: 7 }
    print(f"{slug.area(s)}")
    let g = slug.grow(s, 2)
    print(f"{g.w} {g.h} {g.tags.len()}")
    print(f"{g.note} {g.id}")
    for f in slug.frames(2) {
        print(f"{f.name} {f.size.w} {f.size.h}")
    }
    match slug.find_frame("f1") {
        Some(f) => print(f"found {f.name}")
        None => print("none")
    }
    match slug.parse_size("3x1.5") {
        Ok(s) => print(f"{s.w} {s.h} {s.tags[0]} {s.id}")
        Err(e) => print(e.message())
    }
    match slug.parse_size("3") {
        Ok(s) => print(f"{s.w}")
        Err(e) => print(e.message())
    }
}
