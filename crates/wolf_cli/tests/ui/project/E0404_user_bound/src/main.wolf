module main

types {
    struct Point {
        x: Int
    }

    struct Sorted<T: Comparable> {
        items: List<T>
    }

    struct Prices {
        sorted: Sorted<Float>
    }
}

functions {
    fn largest<T: Comparable + Copyable>(items: List<T>) -> T {
        items[0].copy()
    }

    fn main() {
        let p = largest([Point { x: 1 }])
        print(p.x.to_string())
    }
}
