module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

main {
    var u = make()
    for t in u.tags {
        u.tags.push(t.copy())
    }
    match u.name {
        "a" => change(mut u)
        _ => print("other")
    }
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }
}
