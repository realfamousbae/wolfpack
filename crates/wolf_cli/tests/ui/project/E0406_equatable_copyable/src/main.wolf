module main

types {
    struct Task {
        name: String
        on_done: fn(String)
    }
}

main {
    print("hi")
}

functions {
    fn same(a: Task, b: Task) -> Bool {
        a == b
    }

    fn twice(f: fn(Int) -> Int) -> fn(Int) -> Int {
        f.copy()
    }

    fn errors_equal(a: Error, b: Error) -> Bool {
        a == b
    }
}
