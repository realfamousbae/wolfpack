module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

main {
    let u = make()
    let tags = u.tags
    let first = tags[0]
    print(first)
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }
}
