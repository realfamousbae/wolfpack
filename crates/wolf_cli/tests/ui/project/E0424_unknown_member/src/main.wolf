module main

types {
    struct Point {
        x: Int
        y: Int
    }
}

impl {
    Point {
        fn origin() -> Point {
            Point { x: 0, y: 0 }
        }

        fn sum(self) -> Int {
            self.x + self.y
        }
    }
}

main {
    let p = Point.origin()
    print(p.z.to_string())
    print(p.sum.to_string())
    print(p.total().to_string())
    let q = p.origin()
    let r = Point.sum(p)
    let _ = [q, r]
}
