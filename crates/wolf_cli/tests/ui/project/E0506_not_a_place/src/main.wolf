module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

main {
    change(mut make())
    for t in mut make().tags {
        print(t)
    }
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }
}
