module main

types {
    struct Shelf<T> {
        items: List<T>
    }
}

interfaces {
    interface Sized {
        fn size(self) -> Int where T: Equatable
    }
}

impl {
    Shelf<T> {
        fn has(self, item: T) -> Bool where T: Equatable {
            for x in self.items {
                if x == item {
                    return true
                }
            }
            false
        }

        fn first<U>(self, other: U) -> Int where U: Equatable, V: Copyable {
            self.items.len()
        }
    }

    Shelf<T>: Sized {
        fn size(self) -> Int where T: Copyable {
            self.items.len()
        }
    }
}

main {
    let tasks = Shelf { items: [|| 1] }
    print(tasks.has(|| 2).to_string())
    print(same(1, 1).to_string())
}

functions {
    fn same<T>(a: T, b: T) -> Bool where T: Equatable {
        true
    }
}
