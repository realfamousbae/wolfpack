module main

types {
    struct User {
        name: String
        age: Int
    }
}

main {
    let a = User { name: "a" }
    let b = User { name: "b", age: 2, email: "x" }
    let c = User { name: "c", name: "d", age: 3 }
    match a {
        User { name } => print(name)
    }
    let _ = [b, c]
}
