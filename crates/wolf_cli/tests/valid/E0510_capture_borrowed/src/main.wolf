module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

main {
    let u = make()
    print(names(u).len().to_string())
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }

    fn names(u: User) -> List<String> {
        let name = u.name.copy()
        ["x"].map(|s| s + name)
    }
}
