module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

main {
    var u = make()
    change(mut u)
    print(take(own u).to_string())
    print(take(make()).to_string())
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }
}
