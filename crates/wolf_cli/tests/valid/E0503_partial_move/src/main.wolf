module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }

    fn main() {
        let u = make()
        let tags = u.tags.copy()
        let first = tags[0].copy()
        print(first + u.name)
    }
}
