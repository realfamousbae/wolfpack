module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

main {
    var a = make()
    var b = make()
    swap_names(mut a, mut b)
    merge(mut a.tags, b.tags)
    set_both(mut a.name, mut a.tags)
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }

    fn swap_names(mut x: User, mut y: User) {
        let n = x.name.copy()
        x.name = y.name.copy()
        y.name = n
    }

    fn merge(mut into: List<String>, from: List<String>) {
        for f in from {
            into.push(f.copy())
        }
    }

    fn set_both(mut name: String, mut tags: List<String>) {
        name = "both"
        tags.clear()
    }
}
