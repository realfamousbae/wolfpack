module main

types {
    struct User {
        name: String
        tags: List<String>
    }
}

main {
    var total = 0
    let add = |n: Int| n + 1
    total = add(total)
    print(total.to_string())
}

functions {
    fn take(own u: User) -> Int {
        u.tags.len()
    }

    fn change(mut u: User) {
        u.name = "changed"
    }

    fn make() -> User {
        User { name: "a", tags: ["t"] }
    }
}
