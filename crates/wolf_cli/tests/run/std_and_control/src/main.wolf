module main

imports {
    std.list
    std.map
    std.string
    std.process
}

types {
    struct Pair<T> {
        first: T
        second: T
    }
}

interfaces {
    interface Named {
        fn name(self) -> String
    }
}

impl {
    Pair<T: Comparable + Copyable> {
        fn larger(self) -> T {
            if self.first.compare(self.second) == Ordering.Less {
                self.second.copy()
            } else {
                self.first.copy()
            }
        }
    }
}

main {
    print(classify(0) + " " + classify(-3) + " " + classify(4) + " " + classify(7))
    print(find_first_even([1, 3, 6, 8]).to_string() + " " + find_first_even([1, 3]).to_string())
    print(sign(0).to_string() + " " + sign(5).to_string() + " " + sign(-5).to_string())
    let p = Pair { first: "pear", second: "plum" }
    print(p.larger() + " " + Pair { first: 3, second: 2 }.larger().to_string())
    var slot = 1
    let old = replace(mut slot, 2)
    print("old " + old.to_string() + " new " + slot.to_string())
    let nums = [5, 3, 9, 1]
    var sorted = nums.copy()
    sorted.sort()
    print(string.join(sorted.map(|n| n.to_string()), ","))
    print(
        nums.contains(9).to_string() + " " + list.sum(nums).to_string() + " " +
            list.range(2, 5).len().to_string(),
    )
    match nums.min() {
        Some(m) => print("min " + m.to_string())
        None => print("empty")
    }
    let idx = nums.index_of(9)
    print(match idx {
        Some(i) => i.to_string()
        None => "-"
    })
    var ages: Map<String, Int> = ["ann": 30, "bob": 25]
    let _ = ages.remove("ann")
    let _ = ages.insert("cid", 40)
    for e in ages.copy().entries() {
        print(e.key + " " + e.value.to_string())
    }
    print(string.join(map.values(ages).map(|v| v.to_string()), "+"))
    print(match map.get(ages, "zed") {
        Some(_) => "found"
        None => "missing"
    })
    match "12x".parse_int() {
        Ok(n) => print(n.to_string())
        Err(e) => print(e.message())
    }
    print(
        " a b ".trim() + "|" + "a,b,,c".split(",").len().to_string() + "|" +
            "Hello".to_upper_ascii() + "|" + "ab".repeat(3),
    )
    print(match "hello".find("ll") {
        Some(i) => i.to_string()
        None => "-"
    })
    let doubled = [1, 2, 3].map(|n| halve(n * 2))
    print(doubled.count(|o| o == Some(2)).to_string())
    let maybe = halve(3)
    print((maybe == None).to_string())
    var total = 0
    for n in 1..=4 {
        if n == 3 {
            continue
        }
        total += n
    }
    print(total.to_string())
    print(
        (2.5).round().to_string() + " " + (-2.5).round().to_string() + " " +
            (7.9).to_int().to_string() + " " + (3).pow(4).to_string(),
    )
    process.exit(3)
}

functions {
    fn classify(n: Int) -> String {
        match n {
            0 => "zero"
            x if x < 0 => "negative"
            x if x % 2 == 0 => "even"
            _ => "odd"
        }
    }

    fn find_first_even(items: List<Int>) -> Int {
        var i = 0
        var found = -1
        while true {
            match items.get(i) {
                Some(v) if v % 2 == 0 => {
                    found = v
                    break
                }
                Some(_) => { i += 1 }
                None => break
            }
        }
        found
    }

    fn sign(n: Int) -> Int {
        let s = match n {
            0 => return 0
            x if x > 0 => 1
            _ => -1
        }
        s * 10
    }

    fn halve(n: Int) -> Option<Int> {
        if n % 2 == 0 { Some(n / 2) } else { None }
    }
}
