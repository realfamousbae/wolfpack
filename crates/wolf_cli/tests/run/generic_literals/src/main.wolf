//! Literals passed to read parameters of a type parameter: a string literal is a `String` there,
//! not a `&str` (Rust), and an integer literal an `i64`.
module main

functions {
    fn count_equal<T: Equatable>(items: List<T>, target: T) -> Int {
        var count = 0
        for item in items {
            if item == target {
                count += 1
            }
        }
        count
    }

    fn main() {
        print(count_equal(["a", "b", "a"], "a").to_string())
        print(count_equal([1, 2, 1, 1], 1).to_string())
    }
}
