//! Methods with bounds of their own (spec chapter 4, section 8.6): `where` in a user type, and the
//! methods of `List` that need more from their elements.

module main

types {
    struct Shelf<T> {
        items: List<T>
    }

    struct Book {
        title: String
        pages: Int
    }
}

impl {
    Shelf<T> {
        fn size(self) -> Int {
            self.items.len()
        }

        fn has(self, item: T) -> Bool where T: Equatable {
            for x in self.items {
                if x == item {
                    return true
                }
            }
            false
        }

        fn sorted(self) -> List<T> where T: Comparable + Copyable {
            var out = self.items.copy()
            out.sort()
            out
        }

        fn labels(self) -> String where T: Display {
            var out = ""
            for x in self.items {
                out += "[" + x.to_string() + "]"
            }
            out
        }
    }

    Book: Comparable {
        fn compare(self, other: Book) -> Ordering {
            self.pages.compare(other.pages)
        }
    }
}

main {
    let numbers = Shelf { items: [5, 1, 3] }
    print(f"{numbers.size()} {numbers.has(3)} {numbers.has(4)} {numbers.labels()}")
    let sorted = numbers.sorted()
    print(f"{sorted[0]} {sorted[1]} {sorted[2]}")
    let tasks = Shelf { items: [|| 1, || 2] }
    print(tasks.size().to_string())

    var words = ["pear", "fig", "apple"]
    words.sort()
    print(f"{words[0]} {words.contains("fig")} {words.contains("kiwi")}")
    match words.index_of("pear") {
        Some(i) => print(f"pear at {i}")
        None => print("no pear")
    }
    match words.get(7) {
        Some(w) => print(w)
        None => print("nothing at 7")
    }
    var books = [Book { title: "Long", pages: 900 }, Book { title: "Short", pages: 90 }]
    books.sort()
    print(books[0].title)
    match books.max() {
        Some(b) => print(f"max {b.title}")
        None => print("no books")
    }
    let empty: List<Int> = []
    match empty.min() {
        Some(n) => print(n.to_string())
        None => print("empty has no min")
    }
}
