//! `Display` and `Comparable` of an enum without payloads, a string in TypeScript, used through a
//! type parameter: the user's `to_string` and `compare`, not the variant's name.
module main

imports {
    std.string
}

types {
    enum Color {
        Red
        Green
        Blue
    }

    struct Wrap<T> {
        value: T
    }
}

impl {
    Color: Display {
        fn to_string(self) -> String {
            match self {
                Color.Red => "red"
                Color.Green => "green"
                Color.Blue => "blue"
            }
        }
    }

    Color: Comparable {
        fn compare(self, other: Color) -> Ordering {
            rank(self).compare(rank(other))
        }
    }

    Wrap<T: Display + Comparable + Copyable> {
        fn describe(self) -> String {
            "<" + self.value.to_string() + ">"
        }

        fn larger(self, other: T) -> T {
            match self.value.compare(other) {
                Ordering.Less => other.copy()
                _ => self.value.copy()
            }
        }
    }
}

main {
    print(show(Color.Green))
    print(f"{Color.Blue} {Color.Red.to_string()}")
    print(show(largest([Color.Red, Color.Blue, Color.Green])))
    print(twice(Color.Red))
    var cs = [Color.Blue, Color.Red, Color.Green]
    cs.sort()
    print(string.join(cs.map(|c| c.to_string()), ","))
    print(show(3) + show("s") + show(1.5))
    match cs.max() {
        Some(c) => print(c.to_string())
        None => print("none")
    }
    match [Color.Blue, Color.Green].min() {
        Some(c) => print(c.to_string())
        None => print("none")
    }
    let w = Wrap { value: Color.Green }
    print(
        w.describe() + " " + w.larger(Color.Red).to_string() + " " +
            w.larger(Color.Blue).to_string(),
    )
    print(sorted_names([Color.Blue, Color.Red, Color.Green]) + " " + sorted_names(["b", "a"]))
}

functions {
    fn rank(c: Color) -> Int {
        match c {
            Color.Red => 1
            Color.Green => 2
            Color.Blue => 3
        }
    }

    fn show<T: Display>(v: T) -> String {
        f"[{v}]"
    }

    fn twice<T: Display + Comparable>(v: T) -> String {
        show(v) + v.to_string() +
            match v.compare(v) {
                Ordering.Equal => "="
                _ => "?"
            }
    }

    fn largest<T: Comparable + Copyable>(items: List<T>) -> T {
        var best = items[0].copy()
        for item in items {
            if item.compare(best) == Ordering.Greater {
                best = item.copy()
            }
        }
        best
    }

    fn sorted_names<T: Display + Comparable>(own items: List<T>) -> String {
        var xs = items
        xs.sort()
        string.join(xs.map(|x| show(x)), ",")
    }
}
