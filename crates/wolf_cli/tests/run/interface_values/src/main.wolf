//! Interface values: copies, `mut self` calls through an index; names that are Rust keywords or
//! prelude types; changes of nested places.

module main

imports {
    std.string
}

types {
    struct Box {
        move: Int
        ref: String
    }

    struct Inner {
        c: Int
    }

    struct Outer {
        b: Inner
        tags: List<String>
    }

    struct Vec {
        x: Int
    }

    enum Color {
        Red
        Green
    }
}

interfaces {
    interface Animal {
        fn sound(self) -> String
        fn rename(mut self, own name: String)
    }
}

impl {
    Box {
        fn dyn(self) -> Int { self.move * 2 }
    }

    Color: Animal {
        fn sound(self) -> String {
            match self {
                Color.Red => "red"
                Color.Green => "green"
            }
        }
        fn rename(mut self, own name: String) {}
    }

    Vec: Animal {
        fn sound(self) -> String { "vec " + self.x.to_string() }
        fn rename(mut self, own name: String) { self.x = name.len() }
    }
}

main {
    let where = Box { move: 21, ref: "r" }
    print(where.dyn().to_string() + " " + where.ref)
    var grid = [[1, 2, 3], [4, 5, 6]]
    grid[1][2] = 60
    grid[0][0] += 9
    print(grid[0][0].to_string() + " " + grid[1][2].to_string())
    var m: Map<String, Int> = ["a": 1]
    m["a"] += 41
    print(m["a"].to_string())
    var o = Outer { b: Inner { c: 1 }, tags: ["x"] }
    o.b.c += 2
    o.tags.push("y")
    o.tags[0] += "!"
    print(o.b.c.to_string() + " " + string.join(o.tags, ","))
    print(largest([3, 9, 2]).to_string() + " " + largest(["b", "c", "a"]))
    print(match second_negative([1, -2, -3]) {
        Some(v) => v.to_string()
        None => "none"
    })
    var zoo: List<Animal> = [Vec { x: 1 }, Color.Green, Vec { x: 2 }]
    let zoo2 = zoo.copy()
    zoo[0].rename("abcd")
    print(loud(zoo) + " | " + loud(zoo2))
    let words = "one two three".split(" ")
    var lens = words.map(|w| w.len())
    lens.sort()
    print(lens.map(|n| n.to_string()).len().to_string() + " " + lens[2].to_string())
    let nested = |x: Int| -> Int {
        let add = |y: Int| -> Int { x + y }
        add(10)
    }
    print(nested(5).to_string())
}

functions {
    fn largest<T: Comparable + Copyable>(items: List<T>) -> T {
        var best = items[0].copy()
        for item in items {
            if item.compare(best) == Ordering.Greater {
                best = item.copy()
            }
        }
        best
    }

    fn second_negative(items: List<Int>) -> Option<Int> {
        var seen = 0
        for i in items {
            if i < 0 {
                seen += 1
                if seen == 2 {
                    return Some(i)
                }
            }
        }
        None
    }

    fn loud(animals: List<Animal>) -> String {
        string.join(animals.map(|a| a.sound()), "; ")
    }
}
